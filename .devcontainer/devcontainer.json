{
    "name": "Jackal ROS2 Humble",

    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },

    "initializeCommand": "xhost +local:docker",

    "workspaceFolder": "/workspaces/ros_ws",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/ros_ws,type=bind",
    "mounts" : [
        "source=${localWorkspaceFolder}/clearpath,target=/home/user/clearpath,type=bind"
    ],

    "runArgs": [
    "--net=host",
    "--ipc=host",
    "--privileged",

    "--gpus=all",
    "--env=DISPLAY=${localEnv:DISPLAY}",
    "--env=QT_X11_NO_MITSHM=1",
    "--env=NVIDIA_VISIBLE_DEVICES=all",
    "--env=NVIDIA_DRIVER_CAPABILITIES=graphics,compute,utility,display",

    "--volume=/tmp/.X11-unix:/tmp/.X11-unix:rw",
    "--device=/dev/dri:/dev/dri",

    "--device=/dev/bus/usb:/dev/bus/usb",
    "--device-cgroup-rule=c 189:* rmw"
   ],

    "remoteEnv": {
        "DISPLAY": "${localEnv:DISPLAY}",
        "CLEARPATH_CONFIG_DIR": "/home/user/clearpath"
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-iot.vscode-ros",
                "ms-python.python",
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools"
            ]
        }
    },
    "remoteUser": "user",
    "postCreateCommand": "rosdep update"
}