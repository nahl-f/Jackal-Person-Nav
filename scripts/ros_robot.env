#!/bin/bash

# Check if file is sourced
if [[ $_ == $0 ]]; then
  echo "Error: You need to source this script to set environment variables."
  echo "Usage: source scripts/ros_robot.env <ROBOT_IP>"
  exit 1
fi

if [[ -z "$1" ]]; then
    echo "Error: Need robot IP as argument."
    echo "Usage: source scripts/ros_robot.env <ROBOT_IP>"
    return 1
fi

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
TEMPLATE_FILE="${SCRIPT_DIR}/fastdds_robot_template.xml"

if [[ ! -f "$TEMPLATE_FILE" ]]; then
  echo "Error: Template file not found at ${TEMPLATE_FILE}"
  return 1
fi

# Find own IP on the Robohub network
ROBOHUB_NETWORK="129.97.71."
HOST_IP=""

for ip in $(hostname --all-ip-addresses 2>/dev/null); do
  if [[ $ip == ${ROBOHUB_NETWORK}* ]]; then
    HOST_IP=$ip
  fi
done

if [[ -z "$HOST_IP" ]]; then
    echo "Warning: Could not auto-detect host IP on network ${ROBOHUB_NETWORK}X"
fi

ROBOT_IP="$1"

# Verify robot is alive over network
set +e
ping -W 1 -q -c 1 "$ROBOT_IP" > /dev/null
if [ "$?" != "0" ]; then
    echo "Warning: Robot not reachable at $ROBOT_IP. Check network connection."
fi

export RMW_IMPLEMENTATION=rmw_fastrtps_cpp

GENERATED_XML="$HOME/.fastdds_robot_network.xml"
cat "$TEMPLATE_FILE" | sed "s/ROBOT_IP/${ROBOT_IP}/" | sed "s/HOST_IP/${HOST_IP}/" > "$GENERATED_XML"

export FASTRTPS_DEFAULT_PROFILES_FILE="$GENERATED_XML"

export PS1='\[\033[01;31m\]ROBOT \[\033[01;32m\]\u@jackal\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '

echo "Successfully configured FastDDS for Jackal at $ROBOT_IP"
if [[ -n "$HOST_IP" ]]; then
  echo "Your Laptop IP: $HOST_IP"
fi
echo "If switching setups please stop the background daemon with \"ros2 daemon stop\""

ros2 daemon stop > /dev/null 2>&1

echo "Successfully connected to Jackal!"
echo "Your Laptop IP: $HOST_IP"
echo "Jackal IP: $ROBOT_IP"