#!/bin/bash

# Check if file is sourced
if [[ $_ == $0 ]]; then
  echo "Error: You need to source this script to set environment variables."
  echo "Usage: source scripts/ros_ethernet.env"
  exit 1
fi

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
TEMPLATE_FILE="${SCRIPT_DIR}/fastdds_robot_template.xml"

if [[ ! -f "$TEMPLATE_FILE" ]]; then
  echo "Error: Template file not found at ${TEMPLATE_FILE}"
  return 1
fi

# Find own IP on the Wired Jackal network
WIRED_NETWORK="192.168.131."
HOST_IP=""

for ip in $(hostname --all-ip-addresses 2>/dev/null); do
  if [[ $ip == ${WIRED_NETWORK}* ]]; then
    HOST_IP=$ip
  fi
done

# If it couldn't find your static IP, default to standard setup
if [[ -z "$HOST_IP" ]]; then
    echo "Warning: Could not auto-detect 192.168.131.X IP. Defaulting to 192.168.131.101"
    HOST_IP="192.168.131.101"
fi

ROBOT_IP="192.168.131.1"

set +e
ping -W 1 -q -c 1 $ROBOT_IP > /dev/null
if [ "$?" != "0" ]; then
    echo "Jackal not reachable at $ROBOT_IP. Check your physical cable and static IP setup."
    return 1
fi

export RMW_IMPLEMENTATION=rmw_fastrtps_cpp

GENERATED_XML="$HOME/.fastdds_robot_wired.xml"
cat "$TEMPLATE_FILE" | sed "s/ROBOT_IP/${ROBOT_IP}/" | sed "s/HOST_IP/${HOST_IP}/" > "$GENERATED_XML"

export FASTRTPS_DEFAULT_PROFILES_FILE="$GENERATED_XML"

export PS1='\[\033[01;33m\]WIRED-ROBOT \[\033[01;32m\]\u\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '

ros2 daemon stop > /dev/null 2>&1

echo "Successfully connected to Jackal locally via Ethernet!"
echo "Your Laptop IP: $HOST_IP"
echo "Jackal IP: $ROBOT_IP"